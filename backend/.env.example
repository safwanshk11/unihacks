# Copy this file to backend/.env and fill in what you need.
# backend/.env is gitignored — never commit real keys.

# Which LLM backend hybrid_provider.py calls: "ollama" (default, local, no
# key needed) or "gemini" (cloud, needs GEMINI_API_KEY below).
LLM_BACKEND=ollama

# --- Ollama (only used when LLM_BACKEND=ollama) ---
# OLLAMA_HOST=http://localhost:11434
#
# Model choice measurably changes classification accuracy on cryptic rows.
# Measured on 12 random non-lighting rows from the real 1,000-row dataset:
#   llama3.2:3b  ~9/12 correct department  (2GB, fine for a laptop demo)
#   qwen2.5:7b   ~11/12 correct department (4.7GB, recommended)
# 3b filed a cordless ratchet under "Fasteners" and heated gloves under
# "Lighting"; 7b got both right. Warm latency is comparable (~1-3s/call).
# OLLAMA_MODEL=qwen2.5:7b

# --- Gemini (only used when LLM_BACKEND=gemini) ---
# Free key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Enrichment provider. "hybrid" (default) is the two-lane router: the
# lighting specialist first, the generic model-driven lane for everything
# else. It is currently the only provider.
# LLM_PROVIDER=hybrid

# --- Review console login -------------------------------------------
# Passwords are PBKDF2-hashed at startup; the plaintext is never stored or
# transmitted, and nothing is hardcoded in the repo. Change these before
# putting this anywhere shared.
# AUTH_USERNAME=admin
# AUTH_PASSWORD=lumen-demo
#
# Token signing key. If unset a random one is generated per process, which
# just means sessions end when the server restarts.
# AUTH_SECRET=
#
# Skip login entirely — handy for scripted evaluation runs.
# AUTH_DISABLED=0
